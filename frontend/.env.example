# Backend'e bağlanmadan sadece frontend'i test etmek için:
#   REACT_APP_USE_MOCK=true  -> hiçbir gerçek istek atılmaz, her şey simüle edilir
# Backend hazır olup bağlanacağınız zaman:
#   REACT_APP_USE_MOCK=false yapın ve REACT_APP_API_URL'i doğru adrese ayarlayın
REACT_APP_USE_MOCK=true
REACT_APP_API_URL=http://localhost:4000/api