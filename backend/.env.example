# ==============================================================
# BM Forum Backend - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp '.env' adıyla kaydedin ve değerleri doldurun.
# .env dosyasını ASLA git'e commit etmeyin!
# ==============================================================

# --- Sunucu Ayarları ---
PORT=3000
NODE_ENV=development

# Frontend'in adresi (CORS için). Birden fazla ortam için prod'da değiştirin.
CORS_ORIGIN=http://localhost:3001

# --- Veritabanı (Supabase PostgreSQL - Connection Pooling) ---
# Supabase > Project Settings > Database > Connection Pooling bölümünden alınır.
# Sadece migration (npm run db:init) ve pg pool kullanan kodlar için gerekli.
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- Supabase (API anahtarları) ---
# Supabase > Project Settings > API bölümünden alınır.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role anahtarı RLS'yi baypas eder; SADECE backend'de kullanılır, asla frontend'e vermeyin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase JWT ---
# Supabase > Project Settings > API > JWT Settings > JWT Secret
# (auth middleware ve socket.io token doğrulaması için)
SUPABASE_JWT_SECRET=

# --- Cloudinary (avatar yükleme, opsiyonel) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
