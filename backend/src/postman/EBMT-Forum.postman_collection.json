    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Not: Supabase projede 'Confirm email' acik ise session/token donmeyebilir; boyle durumda asagidaki Login isteginin de calismasi icin Supabase Auth ayarlarindan email confirmation'i test ortaminda kapatmaniz gerekir.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"username\": \"{{test_username}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('test_email')) {",
                  "  const ts = Date.now();",
                  "  pm.environment.set('test_email', `testuser+${ts}@example.com`);",
                  "  pm.environment.set('test_username', `testuser${ts}`);",
                  "  pm.environment.set('test_password', 'TestPass123!');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (yeni kayit) ya da 400 (zaten var)', () => {",
                  "  pm.expect([201,400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  const d = json.data || {};",
                  "  if (d.user && d.user.id) pm.environment.set('user_id', d.user.id);",
                  "  if (d.session && d.session.access_token) {",
                  "    pm.environment.set('access_token', d.session.access_token);",
                  "    pm.environment.set('refresh_token', d.session.refresh_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const d = json.data || {};",
                  "if (d.session && d.session.access_token) {",
                  "  pm.environment.set('access_token', d.session.access_token);",
                  "  pm.environment.set('refresh_token', d.session.refresh_token);",
                  "}",
                  "if (d.user && d.user.id) pm.environment.set('user_id', d.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const d = json.data || {};",
                  "if (d.session && d.session.access_token) {",
                  "  pm.environment.set('access_token', d.session.access_token);",
                  "  pm.environment.set('refresh_token', d.session.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
